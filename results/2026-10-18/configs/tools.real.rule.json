{
  "tools": [
    {
      "name": "ruff",
      "command": ["{python}", "-m", "ruff", "check", "--select", "F,B,S,PLR,PT", "--output-format", "json", "."],
      "adapter": "ruff",
      "categories": ["dead-code", "error-handling", "security"],
      "match": "rule",
      "rules": {"S602": "security.shell-true", "S105": "security.hardcoded-secret"},
      "ignore_paths": ["tests/*"],
      "timeout": 60
    },
    {
      "name": "bandit",
      "command": ["{python}", "-m", "bandit", "-q", "-r", ".", "-f", "json"],
      "adapter": "bandit",
      "categories": ["security", "error-handling"],
      "match": "rule",
      "rules": {"B602": "security.shell-true", "B105": "security.hardcoded-secret", "B110": "error.except-pass"},
      "ignore_paths": ["tests/*"],
      "ignore_rules": ["B101", "B404", "B603", "B607"],
      "timeout": 60,
      "ok_exit_codes": [0, 1]
    }
  ]
}
